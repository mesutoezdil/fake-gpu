{{- /* What demo/setup.sh and demo/run.py print and open after install. */ -}}
{{- toJson (dict
  "mockURL" (printf "http://localhost:%v" .Values.kind.mockDashboardPort)
  "grafanaURL" (printf "http://localhost:%v" .Values.kind.grafanaPort)
  "mockDashboardEnabled" (eq (include "kind.dashboard" .) "true")
  "grafanaEnabled" (eq (include "kind.grafana" .) "true")
  "grafanaPassword" (default "amdmock" .Values.monitoring.grafana.adminPassword)) }}
